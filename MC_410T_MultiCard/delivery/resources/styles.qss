/* ═══════════════════════════════════════════════════════════════════
   MC_410T 上位机软件样式表 v3.2

   设计参考：Keysight / Rohde & Schwarz / Tektronix 专业仪表风格
   - 深色专业基调
   - QRadioButton 选中态高亮（白芯+蓝圈）
   - QSpinBox 箭头完美贴合输入框
   ═══════════════════════════════════════════════════════════════════ */

/* ================================================================
   全局基础
   ================================================================ */
QMainWindow, QDialog { background-color: #1E1E1E; color: #E0E0E0; }
QWidget { background-color: transparent; color: #E0E0E0;
    font-family: "Microsoft YaHei", "Segoe UI", "Noto Sans SC", sans-serif;
    font-size: 13px; }

/* ================================================================
   分组 TabBar
   ================================================================ */
QTabBar { background-color: #252526; border-bottom: 1px solid #3C3C3C; padding: 2px; }
QTabBar::tab { background-color: #333333; color: #9E9E9E; font-weight: bold;
    font-size: 12px; padding: 6px 18px; margin-right: 3px;
    border-radius: 4px 4px 0 0; border: 1px solid #3C3C3C; border-bottom: none;
    min-width: 80px; }
QTabBar::tab:hover { background-color: #3A3A3A; color: #E0E0E0; }
QTabBar::tab:selected { background-color: #0078D4; color: #FFFFFF; border-color: #0078D4; }
QTabBar::tab:selected:hover { background-color: #1A8CE8; }

/* ================================================================
   通道 TabWidget
   ================================================================ */
QTabWidget::tab-bar { background-color: #1E1E1E; border-bottom: 1px solid #3C3C3C; }
QTabWidget::pane { border: 1px solid #3C3C3C; background-color: #1E1E1E; border-top: none; }
QTabWidget QTabBar::tab { background-color: #2A2A2A; color: #888888; font-weight: normal;
    font-size: 12px; padding: 6px 14px; margin-right: 2px;
    border-radius: 4px 4px 0 0; border: 1px solid #3C3C3C; border-bottom: none;
    min-width: 100px; }
QTabWidget QTabBar::tab:hover { background-color: #3A3A3A; color: #E0E0E0; }
QTabWidget QTabBar::tab:selected { background-color: #0078D4; color: #FFFFFF; font-weight: bold; border-color: #0078D4; }
QTabWidget QTabBar::tab:selected:hover { background-color: #1A8CE8; }

/* ================================================================
   按钮体系
   ================================================================ */
QPushButton { color: #FFFFFF; font-weight: bold; font-size: 13px;
    padding: 7px 16px; border: none; border-bottom: 2px solid rgba(0,0,0,0.3);
    border-radius: 4px; min-height: 20px; background-color: #0078D4; }
QPushButton:hover { background-color: #1A8CE8; border-bottom: 2px solid rgba(255,255,255,0.15); }
QPushButton:pressed { background-color: #0062B3; border-bottom: 2px solid rgba(0,0,0,0.4); }
QPushButton:disabled { background-color: #3C3C3C; color: #AAAAAA; border-bottom: 2px solid #333333; }
QPushButton:focus { outline: none; }
QAbstractButton:focus { outline: none; }

QPushButton#btnStartListen { background-color: #009999; font-size: 14px; min-width: 110px; }
QPushButton#btnStartListen[state="stopping"] { background-color: #D13438; }
QPushButton#btnConfig { background-color: #0078D4; font-size: 14px; min-width: 110px; }
QPushButton#btnStartMeasure { background-color: #009999; font-size: 14px; min-width: 110px; }
QPushButton#btnStartMeasure[state="measuring"] { background-color: #D13438; }
QPushButton#btnToggleSave { background-color: #5A5A5A; font-size: 14px; min-width: 110px; }
QPushButton#btnToggleSave[state="saving"] { background-color: #D13438; }
QPushButton#btnSelectDir { background-color: #5A5A5A; padding: 4px 10px; min-height: 18px; max-height: 26px; font-size: 12px; }
QPushButton#btnImagingConfig { background-color: #0078D4; font-size: 12px; min-width: 80px; padding: 5px 12px; }
QPushButton#btnImagingStart { background-color: #009999; font-size: 12px; min-width: 80px; padding: 5px 12px; }
QPushButton#btnImagingStart[imagingRunning="true"] { background-color: #D13438; }

QDialogButtonBox QPushButton { background-color: #0078D4; font-size: 13px; min-width: 80px; padding: 6px 18px; }
QDialogButtonBox QPushButton[isDefaultRestore="true"] { background-color: #5A5A5A; }

/* ================================================================
   单选按钮 —— 选中态白芯+蓝圈（Keysight 风格）
   ================================================================ */
QRadioButton { spacing: 8px; color: #E0E0E0; font-size: 13px; }
QRadioButton:hover { color: #FFFFFF; }
QRadioButton::indicator { width: 18px; height: 18px; border: 2px solid #777777;
    border-radius: 10px; background-color: #2A2A2A; }
QRadioButton::indicator:hover { border-color: #0078D4; }
QRadioButton::indicator:checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.5,
        stop:0 #FFFFFF, stop:0.4 #FFFFFF,
        stop:0.5 #0078D4, stop:1 #0078D4);
    border: 2px solid #0078D4; }
QRadioButton::indicator:disabled { border-color: #4A4A4A; background-color: #222222; }

/* ================================================================
   复选框
   ================================================================ */
QCheckBox { spacing: 8px; color: #E0E0E0; }
QCheckBox:hover { color: #FFFFFF; }
QCheckBox::indicator { width: 18px; height: 18px; border: 2px solid #777777;
    border-radius: 3px; background-color: #2A2A2A; }
QCheckBox::indicator:hover { border-color: #0078D4; background-color: #333333; }
QCheckBox::indicator:checked { background-color: #0078D4; border-color: #0078D4;
    image: url(:/resources/icons/check.svg); }
QCheckBox::indicator:disabled { border-color: #4A4A4A; background-color: #222222; }

/* ================================================================
   输入框
   ================================================================ */
QLineEdit { padding: 5px 8px; border: 1px solid #3C3C3C; border-radius: 3px;
    background-color: #2A2A2A; color: #E0E0E0;
    selection-background-color: #0078D4; selection-color: #FFFFFF; }
QLineEdit:focus { border: 1px solid #0078D4; background-color: #2D2D2D; }
QLineEdit:disabled { background-color: #222222; color: #888888; border-color: #333333; }

/* ================================================================
   分组框
   ================================================================ */
QGroupBox { font-weight: bold; font-size: 13px; color: #CCCCCC;
    border: 1px solid #3C3C3C; border-radius: 5px; margin-top: 10px; padding-top: 12px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left;
    padding: 0 8px; color: #58A6FF; }

/* ================================================================
   组合框
   ================================================================ */
QComboBox { padding: 4px 8px; padding-right: 28px; border: 1px solid #3C3C3C;
    border-radius: 3px; background-color: #2A2A2A; color: #E0E0E0;
    min-height: 20px; max-height: 26px; }
QComboBox:hover { border-color: #555555; }
QComboBox:focus { border: 1px solid #0078D4; }
QComboBox:disabled { background-color: #222222; color: #888888; border-color: #333333; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right;
    width: 22px; border-left: 1px solid #3C3C3C;
    border-top-right-radius: 3px; border-bottom-right-radius: 3px; }
QComboBox::drop-down:hover { background-color: #1A3A5C; }
QComboBox::down-arrow { image: url(:/resources/icons/arrow_combobox.svg); width: 10px; height: 6px; }
QComboBox::drop-down:hover QComboBox::down-arrow { image: url(:/resources/icons/arrow_combobox_hover.svg); }
QComboBox QAbstractItemView { background-color: #2A2A2A; color: #E0E0E0;
    border: 1px solid #3C3C3C; selection-background-color: #0078D4; selection-color: #FFFFFF;
    outline: none; }
QComboBox QAbstractItemView::item { padding: 4px 8px; min-height: 24px; }
QComboBox QAbstractItemView::item:hover { background-color: #1A3A5C; color: #FFFFFF; }
QComboBox QAbstractItemView::item:selected { background-color: #0078D4; color: #FFFFFF; }

/* ================================================================
   数字调节框 —— 上下按钮完美贴合输入框
   ================================================================ */
QSpinBox, QDoubleSpinBox {
    padding: 2px 4px;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    background-color: #2A2A2A;
    color: #E0E0E0;
    min-height: 20px;
    max-height: 20px;
}
QSpinBox:hover, QDoubleSpinBox:hover { border-color: #555555; }
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #0078D4; }
QSpinBox:disabled, QDoubleSpinBox:disabled { background-color: #222222; color: #888888; border-color: #333333; }

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    height: 10px;
    border-left: 1px solid #3C3C3C;
    border-bottom: none;
    border-top-right-radius: 3px;
    background-color: #333333;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    height: 10px;
    border-left: 1px solid #3C3C3C;
    border-top: 1px solid #555555;
    border-bottom-right-radius: 3px;
    background-color: #333333;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover { background-color: #1A3A5C; }
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #1A3A5C; }
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed { background-color: #0D2B45; }
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed { background-color: #0D2B45; }

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/resources/icons/arrow_up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/resources/icons/arrow_down.svg); width: 10px; height: 10px; }
QSpinBox::up-button:hover QSpinBox::up-arrow, QDoubleSpinBox::up-button:hover QDoubleSpinBox::up-arrow { image: url(:/resources/icons/arrow_up_hover.svg); }
QSpinBox::down-button:hover QSpinBox::down-arrow, QDoubleSpinBox::down-button:hover QDoubleSpinBox::down-arrow { image: url(:/resources/icons/arrow_down_hover.svg); }

/* ================================================================
   文本编辑（日志）
   ================================================================ */
QTextEdit, QPlainTextEdit { background-color: #1A1A1A; color: #CCCCCC;
    border: 1px solid #3C3C3C; border-radius: 3px;
    selection-background-color: #0078D4; selection-color: #FFFFFF;
    font-family: "Consolas", "Microsoft YaHei Mono", monospace; font-size: 12px; }

/* ================================================================
   标签
   ================================================================ */
QLabel { color: #E0E0E0; background-color: transparent; }
QLabel[pkpkLabel="true"] { background-color: #0D2B45; color: #58A6FF;
    font-weight: bold; font-size: 12px; padding: 5px 8px; border-radius: 3px;
    border: 1px solid #1F3A5F; }
QLabel[tileTitle="true"] { background-color: #1A3A5C; color: #FFFFFF;
    font-weight: bold; font-size: 11px; padding: 4px 6px; border-radius: 3px;
    border: 1px solid #2D5A8A; }

/* ================================================================
   滚动条
   ================================================================ */
QScrollBar:vertical { background: #2A2A2A; width: 10px; border-radius: 5px; }
QScrollBar::handle:vertical { background: #555555; min-height: 30px; border-radius: 5px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: #2A2A2A; height: 10px; border-radius: 5px; }
QScrollBar::handle:horizontal { background: #555555; min-width: 30px; border-radius: 5px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ================================================================
   进度条 / 菜单
   ================================================================ */
QProgressBar { background-color: #2A2A2A; border: 1px solid #3C3C3C;
    border-radius: 3px; text-align: center; color: #E0E0E0; font-size: 11px; height: 18px; }
QProgressBar::chunk { background-color: #0078D4; border-radius: 2px; }
QMenu { background-color: #2A2A2A; color: #E0E0E0; border: 1px solid #3C3C3C;
    border-radius: 4px; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 3px; }
QMenu::item:selected { background-color: #0078D4; color: #FFFFFF; }
QMenu::separator { height: 1px; background-color: #3C3C3C; margin: 4px 8px; }
